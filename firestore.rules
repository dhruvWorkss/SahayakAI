rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEMO / HACKATHON RULES — open access to the `incidents` collection.
    // Production would require Firebase Auth + role-based rules (see Slide 12 roadmap).
    match /incidents/{doc} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
